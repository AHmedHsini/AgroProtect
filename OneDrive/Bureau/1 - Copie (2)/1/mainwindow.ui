   <string notr="true">
/* mainwindow */
#MainWindow {
	background-color: #fff;
}

#change_btn {
	padding: 5px;
	border: none;
	width: 30px;
	height: 30px;
}

#header_widget {
	background-color: rgb(249, 250, 253);
}

#icon_only_widget {
	background-color: rgb(49, 58, 70);
	width: 50px;
}

#icon_only_widget QPushButton, QLabel {
	height: 50px;
	border: none;
}

#icon_only_widget QPushButton:hover {
	background-color: rgba(86, 101, 115, 0.5);
}

#logo_label_1 {
	padding: 5px;
}

#full_menu_widget {
	background-color: #313a46;
}

#full_menu_widget QPushButton {
	border: none;
	border-radius: 3px;
	text-align: left;
	padding: 8px 0 8px 15px;
	color: #788596;
}

#full_menu_widget QPushButton:hover {
	background-color: rgba(86, 101, 115, 0.5);
}

#full_menu_widget QPushButton:checked {
	color: #fff;
}

#logo_label_2 {
	padding: 0px;
	color: #fff;
}

#search_btn {
	border: none;
}

#search_input {
	border: none;
	padding: 5px 10px;
}

#search_input:focus {
	background-color: #70B9FE;
}

#user_btn {
	border: none;
}














